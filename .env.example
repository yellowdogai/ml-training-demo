# Copy to .env and fill in. .env is ignored by git. Real environment variables win.

# YellowDog application key
YD_KEY=
YD_SECRET=
# YD_URL=https://portal.yellowdog.ai/api
# The namespace configure.py sets up in, and the tag that links tasks to the pool
YD_NAMESPACE=yd-training
# YD_WORKER_TAG=yd-training

# configure.py and the notebook: the AWS CLI profile to use, if not your default
# AWS_PROFILE=
# Your VPC's Name tag or ID, if not each region's default VPC
# AWS_VPC=

# train.py: where to publish, and a write token scoped to that repository
HF_REPO=
HF_TOKEN=
